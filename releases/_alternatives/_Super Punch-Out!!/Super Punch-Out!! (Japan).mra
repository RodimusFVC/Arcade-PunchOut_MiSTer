        <dip name="Copyright" bits="15" ids="Nintendo,Nintendo of America Inc."/>
        <dip name="Coinage" bits="8,11" ids="6C/1C,5C/1C,4C/1C,4C/1C,3C/1C,2C/1C,1C/1C,1C/1C,1 Coin/3 Credits (2 Credits/1 Play),1C/2C,1 Coin/2 Credits (3 Credits/1 Play),1C/3C,1C/4C,1C/5C,1C/6C,Free Play" values="8,4,3,9,12,1,0,14,13,2,11,5,6,10,7,15"/>
