    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>1</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>3</num_buttons>
    <buttons names="L Blow,R Blow,KO Blow,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="10,10">
        <dip name="Difficulty" bits="0,1" ids="Easy,Medium,Hard,Hardest"/>
        <dip name="Time" bits="2,3" ids="Longest,Long,Short,Shortest"/>
        <dip name="Demo Sounds" bits="4" ids="Off,On"/>
        <dip name="Rematch At A Discount" bits="5" ids="Off,On"/>
        <dip name="Service Mode" bits="7" ids="Off,On"/>
        <dip name="Coinage" bits="8,11" ids="5C/1C,4C/1C,3C/1C,2C/1C,1C/1C,1C/1C,1 Coin/2 Credits (2 Credits/1 Play),1 Coin/3 Credits (2 Credits/1 Play),1C/2C,1C/2C,1C/2C,1C/3C,1C/4C,1C/5C,1C/6C,Free Play" values="14,11,12,1,0,3,8,13,2,4,9,5,6,10,7,15"/>
        <dip name="Copyright" bits="15" ids="Nintendo,Nintendo of America Inc."/>
    </switches>

